{
  "name": "polaris",
  "version": "1.0.632",
  "description": "Polaris — Claude Code Command Center",
  "main": "main.js",
  "scripts": {
    "build:contracts": "tsc -p tsconfig.contracts.json",
    "prestart": "npm run build:contracts",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:fast": "electron-builder --config.compression=store --config.asar=false",
    "dist": "electron-builder",
    "dist:public": "electron-builder",
    "check:sync": "node scripts/check-polaris-sync.js",
    "postdist": "node scripts/prune-dist.js",
    "postdist:fast": "node scripts/prune-dist.js",
    "postdist:public": "node scripts/prune-dist.js",
    "test:contracts": "vitest run test/contracts",
    "test:policy": "vitest run test/policy",
    "test:memory": "vitest run test/memory",
    "test:retrieval": "vitest run test/memory/obsidianRetrieval"
  },
  "build": {
    "appId": "com.scott.polaris",
    "productName": "Polaris",
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "sign": false
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "server.js",
      "lib/**/*",
      "mcp/**/*",
      "compiled/**/*",
      "secrets.js",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "mammoth": "^1.12.0",
    "monaco-editor": "^0.55.1",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
