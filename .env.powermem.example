# PowerMem Configuration for Polaris

# OpenRouter API key (for Claude 3.5 Sonnet via PowerMem)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxx

# Database password (only if using PostgreSQL instead of SQLite)
# DB_PASSWORD=your-secure-password

# PowerMem service endpoint (used by server.js to communicate)
# Default is localhost:8000 — change if running on different host
POWERMEM_HOST=http://localhost:8000
POWERMEM_TIMEOUT_MS=10000

# Optional: Enable debug logging
# POWERMEM_DEBUG=1
